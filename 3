package storage

import (
	"gin-app/models"
	"sync"
)

var (
	users  = make([]models.User, 0)
	mutex  = sync.Mutex{}
	nextID = 1
)

func AddUser(name, email string) models.User {
	mutex.Lock()
	defer mutex.Unlock()
	user := models.User{
		ID:    nextID,
		Name:  name,
		Email: email,
	}
	nextID++
	users = append(users, user)
	return user
}
